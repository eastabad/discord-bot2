# Discord Bot环境变量配置模板
# 复制此文件为.env并填入实际值

# ===========================================
# Discord配置
# ===========================================
DISCORD_TOKEN=your_discord_bot_token_here

# ===========================================
# 数据库配置
# ===========================================
DATABASE_URL=postgresql://postgres:discord123@db:5432/discord_bot

# ===========================================
# AI模型配置
# ===========================================
# Gemini API (主要AI模型)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here

# Anthropic Claude (备用AI模型)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (可选)
OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# Order Block图表配置
# ===========================================
# Order Block专用布局ID
OB_LAYOUT_ID=IoT1qwuk

# Chart-img API配置
CHART_IMG_API_KEY=your_chart_img_api_key_here

# TradingView会话配置(访问私有布局)
TRADINGVIEW_SESSION_ID=your_tradingview_session_id_here
TRADINGVIEW_SESSION_ID_SIGN=your_tradingview_session_sign_here

# ===========================================
# 其他配置
# ===========================================
# Flask密钥
FLASK_SECRET_KEY=your_flask_secret_key_here

# 日志级别
LOG_LEVEL=INFO

# 时区配置
TZ=America/New_York